<%- include('../_layout_top', { title: 'Attendance Admin' }) %>

<div class="card">
  <h2>Mark Attendance</h2>
  <form method="POST" action="/staff/admin/attendance" style="display:flex;gap:.75rem;flex-wrap:wrap;align-items:flex-end">
    <div class="form-group" style="margin:0;min-width:160px">
      <label>Employee *</label>
      <select name="employee_id" required>
        <option value="">-- Select --</option>
        <% employees.forEach(e => { %>
          <option value="<%= e.id %>"><%= e.full_name %></option>
        <% }) %>
      </select>
    </div>
    <div class="form-group" style="margin:0">
      <label>Date *</label>
      <input type="date" name="work_date" value="<%= new Date().toISOString().slice(0,10) %>" required>
    </div>
    <div class="form-group" style="margin:0;min-width:120px">
      <label>Status *</label>
      <select name="status" required>
        <option value="PRESENT">Present</option>
        <option value="ABSENT">Absent</option>
      </select>
    </div>
    <div class="form-group" style="margin:0;flex:1;min-width:150px">
      <label>Note</label>
      <input type="text" name="note" placeholder="Optional">
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
  </form>
</div>

<div class="card">
  <h2>Attendance Records</h2>
  <form method="GET" action="/staff/admin/attendance" style="display:flex;gap:.75rem;flex-wrap:wrap;align-items:flex-end;margin-bottom:1rem">
    <div class="form-group" style="margin:0;min-width:160px">
      <label>Employee</label>
      <select name="employee_id">
        <option value="">All</option>
        <% employees.forEach(e => { %>
          <option value="<%= e.id %>" <%= filters.employee_id == e.id ? 'selected' : '' %>><%= e.full_name %></option>
        <% }) %>
      </select>
    </div>
    <div class="form-group" style="margin:0">
      <label>From</label>
      <input type="date" name="from" value="<%= filters.from || '' %>">
    </div>
    <div class="form-group" style="margin:0">
      <label>To</label>
      <input type="date" name="to" value="<%= filters.to || '' %>">
    </div>
    <button type="submit" class="btn btn-primary">Filter</button>
    <a href="/staff/admin/attendance/export?employee_id=<%= filters.employee_id || '' %>&from=<%= filters.from || '' %>&to=<%= filters.to || '' %>"
       class="btn btn-secondary">Export CSV</a>
  </form>

  <% if (sessions.length === 0) { %>
    <p>No records found.</p>
  <% } else { %>
    <div style="overflow-x:auto">
    <table>
      <thead>
        <tr>
          <th>Employee</th>
          <th>Date</th>
          <th>Status</th>
          <th>Note</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% sessions.forEach(s => { %>
        <tr>
          <td><%= s.full_name %></td>
          <td><%= formatDate(s.work_date) %></td>
          <td>
            <span class="badge <%= s.status === 'PRESENT' ? 'badge-green' : 'badge-red' %>">
              <%= s.status %>
            </span>
          </td>
          <td><%= s.note || '' %></td>
          <td>
            <button class="btn btn-sm btn-secondary" onclick='openEdit(<%- JSON.stringify(s) %>)'>Edit</button>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    </div>
  <% } %>
</div>

<!-- Edit Modal -->
<div class="modal-overlay" id="editModal">
  <div class="modal" style="max-width:450px">
    <button class="modal-close" onclick="closeEdit()">&times;</button>
    <h2>Edit Record</h2>
    <form id="editForm" method="POST">
      <div class="form-group">
        <label>Status</label>
        <select name="status" id="e_status">
          <option value="PRESENT">Present</option>
          <option value="ABSENT">Absent</option>
        </select>
      </div>
      <div class="form-group">
        <label>Note</label>
        <textarea name="note" id="e_note"></textarea>
      </div>
      <div class="form-group">
        <label>Reason for edit</label>
        <input type="text" name="reason" placeholder="e.g. Correcting record">
      </div>
      <button type="submit" class="btn btn-primary">Save</button>
      <button type="button" class="btn btn-secondary" onclick="closeEdit()">Cancel</button>
    </form>
  </div>
</div>

<script>
function openEdit(s){
  document.getElementById('editForm').action='/staff/admin/attendance/'+s.id+'/edit';
  document.getElementById('e_status').value=s.status;
  document.getElementById('e_note').value=s.note||'';
  document.getElementById('editModal').classList.add('open');
}
function closeEdit(){document.getElementById('editModal').classList.remove('open')}
document.getElementById('editModal').addEventListener('click',function(e){
  if(e.target===this) closeEdit();
});
</script>

<%- include('../_layout_bottom') %>
