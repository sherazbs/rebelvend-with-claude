<%- include('_layout_top', { title: 'Attendance' }) %>

<div class="card" style="text-align:center">
  <h2>Welcome, <%= user.fullName %></h2>
  <p style="font-size:1.1rem;margin-bottom:1rem"><%= new Date().toLocaleDateString('en-GB', { weekday:'long', day:'numeric', month:'long', year:'numeric' }) %></p>

  <% if (today) { %>
    <p style="margin-bottom:.5rem">
      <span class="badge badge-green" style="font-size:1rem;padding:.4rem 1rem">PRESENT</span>
    </p>
    <p>You are marked present for today.</p>
  <% } else { %>
    <form method="POST" action="/staff/attendance/mark-present" style="display:inline">
      <button type="submit" class="btn btn-success" style="font-size:1rem;padding:.6rem 2rem">Mark Present</button>
    </form>
  <% } %>
</div>

<div class="card">
  <h2>Recent Attendance</h2>
  <% if (recent.length === 0) { %>
    <p>No attendance records yet.</p>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>Date</th>
          <th>Status</th>
          <th>Note</th>
        </tr>
      </thead>
      <tbody>
        <% recent.forEach(r => { %>
        <tr>
          <td><%= formatDate(r.work_date) %></td>
          <td>
            <span class="badge <%= r.status === 'PRESENT' ? 'badge-green' : 'badge-red' %>">
              <%= r.status %>
            </span>
          </td>
          <td><%= r.note || '' %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('_layout_bottom') %>
